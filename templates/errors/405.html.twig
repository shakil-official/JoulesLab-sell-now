{% extends "layouts/app.html.twig" %}

{% block title %}405 - Method Not Allowed{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">405 - Method Not Allowed</h4>
                </div>
                <div class="card-body">
                    <p>The <strong>{{ method }}</strong> method is not allowed for the requested URL.</p>
                    
                    {% if allowedMethods is defined and allowedMethods|length > 0 %}
                        <p>Allowed methods: <code>{{ allowedMethods|join(', ') }}</code></p>
                    {% endif %}
                    
                    <p>Requested URL: <code>{{ uri }}</code></p>
                    
                    <hr>
                    
                    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                    <a href="/" class="btn btn-secondary">Go to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
